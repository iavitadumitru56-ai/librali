function Section:CreateDropdown(name, desc, options, default, callback)
    if type(desc) == "table" then
        callback = default
        default = options
        options = desc
        desc = nil
    end
    local row = self:_row(name, desc)
    local values = table.clone(options or {})
    local selected = default
    local closePopup = nil

    local badge = create("TextButton", {
        Text = selected or "select...",
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextColor3 = selected and Colors.Text or Colors.Dim,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        BackgroundColor3 = Colors.Background,
        AutoButtonColor = false,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(130, 24),
        Parent = row,
    })
    addCorner(badge, 6)
    local badgeStroke = addStroke(badge)
    create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 20), Parent = badge })

    local function setSelected(val, silent)
        selected = val
        badge.Text = val or "select..."
        badge.TextColor3 = val and Colors.Text or Colors.Dim
        if val and not silent and callback then task.spawn(callback, val) end
    end

    connect(badge.MouseButton1Click, function()
        if closePopup then closePopup() return end
        local backdrop = create("TextButton", {
            Text = "",
            BackgroundTransparency = 1,
            AutoButtonColor = false,
            Size = UDim2.fromScale(1, 1),
            ZIndex = 149,
            Parent = Library.Gui,
        })

        local visibleRows = math.max(1, math.min(#values, 5))
        local popupHeight = visibleRows * 26 + 8
        local rel = badge.AbsolutePosition - Library.Gui.AbsolutePosition
        local x = math.clamp(rel.X, 4, math.max(4, Library.Gui.AbsoluteSize.X - 134))
        local below = rel.Y + badge.AbsoluteSize.Y + 4
        local y = below + popupHeight <= Library.Gui.AbsoluteSize.Y - 4 and below or math.max(4, rel.Y - popupHeight - 4)

        local popup = create("Frame", {
            Position = UDim2.fromOffset(x, y),
            Size = UDim2.fromOffset(130, popupHeight),
            BackgroundColor3 = Colors.Panel,
            ZIndex = 150,
            Parent = Library.Gui,
        })
        addCorner(popup, 7)
        create("UIStroke", { Color = Colors.Accent, Transparency = 0.45, Thickness = 1, Parent = popup })

        local list = create("ScrollingFrame", {
            Position = UDim2.fromOffset(4, 4),
            Size = UDim2.new(1, -8, 1, -8),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = #values > 5 and 2 or 0,
            CanvasSize = UDim2.fromOffset(0, math.max(22, #values * 26)),
            ZIndex = 151,
            Parent = popup,
        })

        closePopup = function()
            closePopup = nil
            if backdrop.Parent then backdrop:Destroy() end
            if popup.Parent then popup:Destroy() end
            tween(badgeStroke, 0.2, { Color = Colors.Stroke })
        end

        connect(backdrop.MouseButton1Click, closePopup)
        tween(badgeStroke, 0.15, { Color = Colors.Accent })

        for i, val in ipairs(values) do
            local opt = create("TextButton", {
                Text = val,
                Font = selected == val and Enum.Font.GothamBold or Enum.Font.GothamMedium,
                TextSize = 10,
                TextColor3 = selected == val and Colors.Accent or Colors.Text,
                TextTruncate = Enum.TextTruncate.AtEnd,
                BackgroundColor3 = selected == val and Colors.Hover or Colors.Element,
                AutoButtonColor = false,
                Position = UDim2.fromOffset(0, (i - 1) * 26),
                Size = UDim2.new(1, -2, 0, 22),
                ZIndex = 152,
                Parent = list,
            })
            addCorner(opt, 5)
            connect(opt.MouseButton1Click, function()
                setSelected(val)
                closePopup()
            end)
        end
    end)

    return {
        Get = function() return selected end,
        Set = setSelected,
        Update = function(newOpts)
            values = table.clone(newOpts or {})
            if selected and not table.find(values, selected) then setSelected(nil, true) end
            if closePopup then closePopup() end
        end
    }
end

function Section:CreateKeybind(name, desc, default, callback)
    if typeof(default) == "function" and callback == nil then
        callback = default
        default = desc
        desc = nil
    end
    local currentKey = default or Enum.KeyCode.E
    local cfgKey = self.tab.label.Text .. "/" .. self.name .. "/" .. name
    local row = self:_row(name, desc)

    local badge = create("TextLabel", {
        Text = currentKey.Name,
        Font = Enum.Font.GothamBold,
        TextSize = 10,
        TextColor3 = Colors.Text,
        BackgroundColor3 = Colors.Background,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(84, 22),
        Parent = row,
    })
    addCorner(badge, 6)
    local badgeStroke = addStroke(badge)

    connect(row.MouseButton1Click, function()
        if Library.KeyListener then return end
        badge.Text = "press a key..."
        tween(badgeStroke, 0.15, { Color = Colors.Accent })

        Library.KeyListener = function(k)
            if k and k ~= Enum.KeyCode.Escape then
                currentKey = k
                setConfig(cfgKey, k.Name)
                if callback then task.spawn(callback, k) end
            end
            badge.Text = currentKey.Name
            tween(badgeStroke, 0.3, { Color = Colors.Stroke })
        end
    end)

    register(cfgKey, function(v)
        local ok, k = pcall(function() return Enum.KeyCode[v] end)
        if ok and k then currentKey = k badge.Text = k.Name end
    end, function() return currentKey.Name end, currentKey.Name)

    return {
        Get = function() return currentKey end,
        Set = function(k) currentKey = k badge.Text = k.Name end
    }
end

