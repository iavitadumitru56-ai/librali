        Position = UDim2.fromOffset(12, 9.5),
        Size = UDim2.fromOffset(13, 13),
        BackgroundTransparency = 1,
        ZIndex = 21,
        Parent = searchBar,
    })
    local searchRing = create("Frame", { Size = UDim2.fromOffset(9, 9), BackgroundTransparency = 1, ZIndex = 21, Parent = searchIcon })
    makeRound(searchRing)
    local ringStroke = create("UIStroke", { Color = Colors.Dim, Thickness = 1.5, Parent = searchRing })
    local searchHandle = line(searchIcon, 7.8, 7.8, 12, 12, 1.5, Colors.Dim)
    searchHandle.ZIndex = 21

    local searchBox = create("TextBox", {
        Text = "",
        PlaceholderText = "Search...",
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = Colors.Accent,
        PlaceholderColor3 = Colors.Muted,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(32, 0),
        Size = UDim2.new(1, -100, 1, 0),
        ZIndex = 21,
        Parent = searchBar,
    })

    local hint = create("TextLabel", {
        Text = "Ctrl  F",
        Font = Enum.Font.GothamBold,
        TextSize = 9,
        TextColor3 = Colors.Dim,
        BackgroundColor3 = Colors.Element,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(46, 18),
        Visible = UserInputService.KeyboardEnabled,
        ZIndex = 21,
        Parent = searchBar,
    })
    addCorner(hint, 5)
    addStroke(hint)

    connect(searchBox:GetPropertyChangedSignal("Text"), function()
        local q = searchBox.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
        if q == "" then
            searchTerms = nil
            for _, t in ipairs(tabs) do layoutTab(t) end
            return
        end
        local words = {}
        for w in q:gmatch("%S+") do table.insert(words, w) end
        searchTerms = words
        for _, t in ipairs(tabs) do layoutTab(t) end
    end)

    connect(UserInputService.InputBegan, function(input)
        if input.KeyCode == Enum.KeyCode.F and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
            if not Library.IsOpen then Library:SetMenuOpen(true) end
            task.defer(function() searchBox:CaptureFocus() end)
        end
    end)

    return Window
end

-- Водяной знак (HUD)
function Library:InitWatermark()
    local wmHolder = create("Frame", {
        Name = "WatermarkHolder",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12, 12),
        Size = UDim2.fromOffset(320, 36),
        ZIndex = 50,
        Parent = self.Gui,
    })

    local watermark = create("TextButton", {
        Name = "Watermark",
        Text = "",
        AutoButtonColor = false,
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundColor3 = Colors.Background,
        BackgroundTransparency = 0.04,
        Size = UDim2.fromOffset(0, 36),
        ZIndex = 50,
        Parent = wmHolder,
    })
    addCorner(watermark, 10)
    addStroke(watermark, Colors.Accent)

    create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = watermark })
    create("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Padding = UDim.new(0, 9),
        Parent = watermark,
    })

    local wmLabel = create("TextLabel", {
        Text = "HUB",
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextColor3 = Colors.Accent,
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(0, 36),
        Parent = watermark,
    })
    addGradient(wmLabel)

    local statsLabel = create("TextLabel", {
        Text = "60 fps  ·  20 ms  ·  00:00",
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextColor3 = Colors.Text,
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(0, 36),
        Parent = watermark,
    })

    local dragging, dragStart, startPos
    connect(watermark.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = wmHolder.Position
        end
    end)
    connect(UserInputService.InputChanged, function(input)
        if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging then
            local delta = input.Position - dragStart
            wmHolder.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local frameCount, lastUpdate = 0, os.clock()
    connect(RunService.RenderStepped, function()
        frameCount += 1
        local now = os.clock()
        if now - lastUpdate >= 0.5 then
            local fps = math.floor(frameCount / (now - lastUpdate) + 0.5)
            frameCount, lastUpdate = 0, now
            local ping = math.floor(player:GetNetworkPing() * 1000 + 0.5)
            statsLabel.Text = string.format("%d fps  ·  %d ms  ·  %s", fps, ping, os.date("%H:%M"))
        end
    end)

    connect(watermark.MouseButton1Click, function()
        self:SetMenuOpen(not self.IsOpen)
    end)
end

function Library:Unload()
    for _, c in ipairs(self.Connections) do c:Disconnect() end
    table.clear(self.Connections)
    self.KeyListener = nil

    if self.Blur then self.Blur:Destroy() end
    if self.Gui then self.Gui:Destroy() end
    if self.Dirty then self:SaveConfig() end
end

return Library


