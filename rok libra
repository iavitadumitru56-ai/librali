local notifications = {}

local function notifyStyle(head)
    local h = head:lower()
    if h:find("error") or h:find("fail") then return Color3.fromRGB(255, 70, 70), "cross"
    elseif h:find("warn") then return Color3.fromRGB(255, 180, 50), "!"
    elseif h:find("success") or h:find("on") then return Color3.fromRGB(110, 230, 140), "check" end
    return Colors.Accent, "i"
end

local function layoutNotifications()
    for i, t in ipairs(notifications) do
        local y = -20 - (i - 1) * 68
        tween(t.card, 0.35, { Position = UDim2.new(1, -20, 1, y) }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
    end
end

