local function openColorPicker(anchor, startColor, defaultColor, onChange)
    local h, sat, v = startColor:ToHSV()
    local backdrop = create("TextButton", {
        Text = "",
        AutoButtonColor = false,
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 149,
        Parent = Library.Main,
    })
    addCorner(backdrop, 10)
    tween(backdrop, 0.3, { BackgroundTransparency = 0.45 })

    local popup = create("CanvasGroup", {
        Active = true,
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Colors.Panel,
        GroupTransparency = 1,
        Size = UDim2.fromOffset(264, 344),
        ZIndex = 150,
        Parent = Library.Gui,
    })
    addCorner(popup, 12)
    create("UIStroke", { Color = Colors.Accent, Transparency = 0.82, Thickness = 1, Parent = popup })
    local popupScale = create("UIScale", { Scale = 0.08, Parent = popup })

    local function relPos(inst) return inst.AbsolutePosition - Library.Gui.AbsolutePosition end
    local function mainCenter()
        local p, sz = relPos(Library.Main), Library.Main.AbsoluteSize
        return UDim2.fromOffset(p.X + sz.X / 2, p.Y + sz.Y / 2)
    end
    local function anchorCenter()
        local p, sz = relPos(anchor), anchor.AbsoluteSize
        return UDim2.fromOffset(p.X + sz.X / 2, p.Y + sz.Y / 2)
    end

    popup.Position = anchorCenter()

    create("TextLabel", {
        Text = "Color Picker",
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = Colors.Dim,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 32),
        ZIndex = 151,
        Parent = popup,
    })

    local sq = create("Frame", {
        Active = true,
        Position = UDim2.fromOffset(14, 36),
        Size = UDim2.fromOffset(236, 150),
        BackgroundColor3 = Color3.fromHSV(h, 1, 1),
        ZIndex = 151,
        Parent = popup,
    })
    addCorner(sq, 8)

    local whiteLayer = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Colors.Accent, ZIndex = 152, Parent = sq })
    addCorner(whiteLayer, 8)
    create("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = whiteLayer })

    local blackLayer = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), ZIndex = 153, Parent = sq })
    addCorner(blackLayer, 8)
    create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = blackLayer })

    local svCursor = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(14, 14),
        BackgroundTransparency = 1,
        ZIndex = 155,
        Parent = sq,
    })
    makeRound(svCursor)
    create("UIStroke", { Color = Colors.Accent, Thickness = 2, Parent = svCursor })

    local hueBar = create("Frame", {
        Active = true,
        Position = UDim2.fromOffset(14, 198),
        Size = UDim2.fromOffset(236, 12),
        BackgroundColor3 = Colors.Accent,
        ZIndex = 151,
        Parent = popup,
    })
    makeRound(hueBar)
    local hueKps = {}
    for i = 0, 6 do table.insert(hueKps, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6 % 1, 1, 1))) end
    create("UIGradient", { Color = ColorSequence.new(hueKps), Parent = hueBar })

    local hueKnob = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = Colors.Accent,
        ZIndex = 153,
        Parent = hueBar,
    })
    makeRound(hueKnob)

    local previewNew = create("Frame", {
        Position = UDim2.fromOffset(14, 224),
        Size = UDim2.fromOffset(56, 30),
        BackgroundColor3 = startColor,
        ZIndex = 151,
        Parent = popup,
    })
    addCorner(previewNew, 8)
    addStroke(previewNew, Colors.Hover)

    local hexBox = create("TextBox", {
        Text = "#" .. startColor:ToHex():upper(),
        PlaceholderText = "#FFFFFF",
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = Colors.Text,
        PlaceholderColor3 = Colors.Muted,
        ClearTextOnFocus = false,
        BackgroundColor3 = Colors.Element,
        Position = UDim2.fromOffset(78, 224),
        Size = UDim2.new(1, -92, 0, 30),
        ZIndex = 151,
        Parent = popup,
    })
    addCorner(hexBox, 8)
    addStroke(hexBox)
    create("UIPadding", { PaddingLeft = UDim.new(0, 10), Parent = hexBox })

    local swatches = {}
    local gap = (236 - #presets * 20) / (#presets - 1)
    for i, c in ipairs(presets) do
        local b = create("TextButton", {
            Text = "",
            AutoButtonColor = false,
            BackgroundColor3 = c,
            Position = UDim2.fromOffset(14 + (i - 1) * (20 + gap), 266),
            Size = UDim2.fromOffset(20, 20),
            ZIndex = 151,
            Parent = popup,
        })
        makeRound(b)
        local st = create("UIStroke", { Color = Colors.Accent, Thickness = 1.5, Transparency = 1, Parent = b })
        swatches[i] = { btn = b, stroke = st, color = c }
    end

    local done = create("TextButton", {
        Text = "Done",
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = Colors.Background,
        AutoButtonColor = false,
        BackgroundColor3 = Colors.Accent,
        Position = UDim2.fromOffset(14, 300),
        Size = UDim2.new(1, -28, 0, 30),
        ZIndex = 151,
        Parent = popup,
    })
    addCorner(done, 8)

    local function refresh(keepText)
        local c = Color3.fromHSV(h, sat, v)
        sq.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        svCursor.Position = UDim2.fromScale(sat, 1 - v)
        hueKnob.Position = UDim2.fromScale(h, 0.5)
        previewNew.BackgroundColor3 = c
        if not keepText then hexBox.Text = "#" .. c:ToHex():upper() end
        for _, sw in ipairs(swatches) do
            sw.stroke.Transparency = sw.color:ToHex() == c:ToHex() and 0 or 1
        end
        onChange(c)
    end

    refresh()

    local dragging = nil
    local conns = {}
    local function bind(sig, fn)
        local c = sig:Connect(fn)
        table.insert(conns, c)
        table.insert(Library.Connections, c)
    end

    local function dragTo(pos)
        if dragging == "sq" then
            local p, sz = sq.AbsolutePosition, sq.AbsoluteSize
            sat = math.clamp((pos.X - p.X) / sz.X, 0, 1)
            v = 1 - math.clamp((pos.Y - p.Y) / sz.Y, 0, 1)
        elseif dragging == "hue" then
            local p, sz = hueBar.AbsolutePosition, hueBar.AbsoluteSize
            h = math.clamp((pos.X - p.X) / sz.X, 0, 0.999)
        end
        refresh()
    end

    bind(sq.InputBegan, function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = "sq"
            dragTo(inp.Position)
        end
    end)
    bind(hueBar.InputBegan, function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = "hue"
            dragTo(inp.Position)
        end
    end)
    bind(UserInputService.InputChanged, function(inp)
        if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
            dragTo(inp.Position)
        end
    end)
    bind(UserInputService.InputEnded, function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = nil
        end
    end)

    for _, sw in ipairs(swatches) do
        bind(sw.btn.MouseButton1Click, function()
            h, sat, v = sw.color:ToHSV()
            refresh()
        end)
    end

    bind(hexBox.FocusLost, function()
        local hex = hexBox.Text:gsub("[^%x]", "")
        local ok, c = pcall(Color3.fromHex, hex)
        if ok and c and #hex == 6 then
            h, sat, v = c:ToHSV()
            refresh()
        else
            refresh()
        end
    end)

    tween(popup, 0.45, { Position = mainCenter() }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
    tween(popupScale, 0.5, { Scale = 1 }, Enum.EasingDirection.Out, Enum.EasingStyle.Back)
    tween(popup, 0.25, { GroupTransparency = 0 })

    local closing = false
    local function close(instant)
        if closing then return end
        closing = true
        if Library.ActiveColorPicker == close then Library.ActiveColorPicker = nil end
        for _, c in ipairs(conns) do c:Disconnect() end
        if instant then
            backdrop:Destroy()
            popup:Destroy()
            return
        end
        tween(backdrop, 0.2, { BackgroundTransparency = 1 })
        tween(popup, 0.25, { Position = anchorCenter(), GroupTransparency = 1 }, Enum.EasingDirection.In, Enum.EasingStyle.Quint)
        local t = tween(popupScale, 0.25, { Scale = 0.05 }, Enum.EasingDirection.In)
        t.Completed:Connect(function()
            backdrop:Destroy()
            popup:Destroy()
        end)
    end

    Library.ActiveColorPicker = close
    bind(done.MouseButton1Click, function() close() end)
    bind(backdrop.MouseButton1Click, function() if not dragging then close() end end)
    return close
end

function Section:CreateColorPicker(name, desc, default, callback)
    if typeof(default) == "function" and callback == nil then
        callback = default
        default = desc
        desc = nil
    end
    local color = default or Color3.fromRGB(255, 255, 255)
    local cfgKey = self.tab.label.Text .. "/" .. self.name .. "/" .. name
    local row = self:_row(name, desc)

    local swatch = create("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(38, 22),
        BackgroundColor3 = color,
        ZIndex = 2,
        Parent = row,
    })
    addCorner(swatch, 6)
    addStroke(swatch)

    local hexLabel = create("TextLabel", {
        Text = "#" .. color:ToHex():upper(),
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextColor3 = Colors.Dim,
        TextXAlignment = Enum.TextXAlignment.Right,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -56, 0.5, 0),
        Size = UDim2.fromOffset(70, 20),
        ZIndex = 2,
        Parent = row,
    })

    local function apply(c, silent)
        color = c
        swatch.BackgroundColor3 = c
        hexLabel.Text = "#" .. c:ToHex():upper()
        setConfig(cfgKey, c:ToHex())
        if not silent and callback then task.spawn(callback, c) end
    end

    connect(row.MouseButton1Click, function()
        if Library.ActiveColorPicker then Library.ActiveColorPicker(true) end
        Library.ActiveColorPicker = openColorPicker(swatch, color, default, function(c)
            apply(c)
        end)
    end)

    register(cfgKey, function(v)
        local ok, c = pcall(Color3.fromHex, v)
        if ok and c then apply(c, true) end
    end, function() return color:ToHex() end, color:ToHex())

    return {
        Set = function(c, silent) apply(c, silent) end,
        Get = function() return color end
    }
end

