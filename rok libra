local Section = {}
Section.__index = Section

local function addSection(tab, name, group)
    local card = create("Frame", { BackgroundColor3 = Colors.Panel, Parent = tab.page })
    addCorner(card, 10)
    local stroke = addStroke(card)
    create("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new(Colors.Accent, Color3.fromRGB(190, 190, 190)),
        Parent = card,
    })

    local highlight = create("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 12, 0, 15),
        Size = UDim2.fromOffset(3, 12),
        BackgroundColor3 = Colors.Accent,
        BorderSizePixel = 0,
        Parent = card,
    })
    makeRound(highlight)
    addGradient(highlight)

    create("TextLabel", {
        Text = string.upper(name),
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextColor3 = Colors.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(22, 0),
        Size = UDim2.new(1, -34, 0, 30),
        Parent = card,
    })

    connect(card.MouseEnter, function() tween(stroke, 0.2, { Color = Color3.fromRGB(56, 56, 56) }) end)
    connect(card.MouseLeave, function() tween(stroke, 0.2, { Color = Colors.Stroke }) end)

    local s = setmetatable({
        tab = tab,
        card = card,
        name = name,
        items = {},
        y = 30,
        height = 32,
        rows = {},
        open = 1,
        group = group or (tab.subs and tab.subs[1]),
    }, Section)

    table.insert(tab.sections, s)
    layoutTab(tab)
    return s
end

function Section:Collapsible(startOpen)
    self.collapsible = true
    self.isOpen = startOpen and true or false
    self.open = self.isOpen and 1 or 0
    self.card.ClipsDescendants = true
    local stroke = self.card:FindFirstChildOfClass("UIStroke")

    local headerBtn = create("TextButton", {
        Text = "",
        BackgroundColor3 = Colors.Element,
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Size = UDim2.new(1, 0, 0, 30),
        ZIndex = 4,
        Parent = self.card,
    })

    local hint = create("TextLabel", {
        Text = self.isOpen and "hide" or "open",
        Font = Enum.Font.GothamMedium,
        TextSize = 10,
        TextColor3 = Colors.Muted,
        TextXAlignment = Enum.TextXAlignment.Right,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -30, 0, 15),
        Size = UDim2.fromOffset(40, 14),
        ZIndex = 5,
        Parent = self.card,
    })

    local arrow = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(1, -18, 0, 15),
        Size = UDim2.fromOffset(10, 6),
        BackgroundTransparency = 1,
        Rotation = self.isOpen and 180 or 0,
        ZIndex = 5,
        Parent = self.card,
    })
    line(arrow, 1, 1, 5, 5, 1.6).ZIndex = 5
    line(arrow, 5, 5, 9, 1, 1.6).ZIndex = 5

    local anim = Instance.new("NumberValue")
    anim.Value = self.open
    connect(anim.Changed, function(v)
        self.open = v
        layoutTab(self.tab)
    end)

    local openTween = nil
    local function toggleCollapse()
        self.isOpen = not self.isOpen
        local on = self.isOpen
        if on then for _, r in ipairs(self.rows) do r.Visible = true end end
        if openTween then openTween:Cancel() end
        openTween = tween(anim, on and 0.4 or 0.3, { Value = on and 1 or 0 }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
        openTween.Completed:Connect(function(st)
            if st == Enum.PlaybackState.Completed and not self.isOpen then
                for _, r in ipairs(self.rows) do r.Visible = false end
            end
        end)
        tween(arrow, 0.35, { Rotation = on and 180 or 0 }, Enum.EasingDirection.Out, Enum.EasingStyle.Back)
        hint.Text = on and "hide" or "open"
        if stroke then
            stroke.Color = Colors.Accent
            tween(stroke, 0.5, { Color = Colors.Stroke })
        end
    end

    connect(headerBtn.MouseButton1Click, toggleCollapse)
    layoutTab(self.tab)
    return self
end

function Section:_row(name, desc, height)
    local h = height or (desc and 40 or 32)
    local row = create("TextButton", {
        Text = "",
        BackgroundColor3 = Colors.Element,
        AutoButtonColor = false,
        Position = UDim2.fromOffset(8, self.y),
        Size = UDim2.new(1, -16, 0, h),
        ClipsDescendants = true,
        Parent = self.card,
    })
    addCorner(row, 7)
    local rowStroke = addStroke(row)
    table.insert(self.rows, row)
    table.insert(self.items, {
        row = row,
        y = self.y,
        h = h,
        name = name,
        desc = desc,
        key = (name .. " " .. (desc or "")):lower(),
    })

    if self.collapsible and not self.isOpen then row.Visible = false end
    self.y += h + 6
    self.height = self.y + 8 - 6
    layoutTab(self.tab)

    local accent = create("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(2, 0),
        BackgroundColor3 = Colors.Accent,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = row,
    })
    addCorner(accent, 1)

    local titleLbl = create("TextLabel", {
        Text = name,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = Colors.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12, desc and 6 or 0),
        Size = UDim2.new(1, -150, 0, desc and 15 or h),
        Parent = row,
    })

    if desc then
        create("TextLabel", {
            Text = desc,
            Font = Enum.Font.Gotham,
            TextSize = 10,
            TextColor3 = Colors.Muted,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(12, 21),
            Size = UDim2.new(1, -150, 0, 13),
            Parent = row,
        })
    end

    local hovered, active = false, false
    local function refresh()
        local lit = hovered or active
        tween(accent, 0.3, { Size = UDim2.fromOffset(2, active and h - 14 or (hovered and 12 or 0)) }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
        tween(row, 0.15, { BackgroundColor3 = hovered and Colors.Hover or Colors.Element })
        tween(titleLbl, 0.2, {
            TextColor3 = lit and Colors.Accent or Colors.Text,
            Position = UDim2.fromOffset(hovered and 15 or 12, titleLbl.Position.Y.Offset),
        }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
        tween(rowStroke, 0.2, { Color = active and Colors.ActiveStroke or (hovered and Colors.HoverStroke or Colors.Stroke) })
    end

    connect(row.MouseEnter, function() hovered = true refresh() end)
    connect(row.MouseLeave, function() hovered = false refresh() end)

    local function highlight(on)
        active = on
        refresh()
    end

    return row, titleLbl, rowStroke, highlight
end

function Section:CreateToggle(name, desc, default, callback)
    if type(desc) == "boolean" and callback == nil then
        callback = default
        default = desc
        desc = nil
    end
    local state = default or false
    local cfgKey = self.tab.label.Text .. "/" .. self.name .. "/" .. name
    local row, _, _, highlight = self:_row(name, desc)

    local track = create("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(34, 18),
        BackgroundColor3 = Colors.Background,
        BorderSizePixel = 0,
        Parent = row,
    })
    makeRound(track)
    local trackStroke = addStroke(track)

    local glow = create("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Colors.Accent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = track,
    })
    makeRound(glow)
    create("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(150, 150, 150), Colors.Accent), Parent = glow })

    local knob = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 9, 0.5, 0),
        Size = UDim2.fromOffset(12, 12),
        BackgroundColor3 = Colors.Dim,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = track,
    })
    makeRound(knob)

    local function apply(v, silent)
        state = v
        knob.Size = UDim2.fromOffset(18, 12)
        tween(knob, 0.35, {
            Position = UDim2.new(0, state and 25 or 9, 0.5, 0),
            Size = UDim2.fromOffset(12, 12),
            BackgroundColor3 = state and Colors.Background or Colors.Dim,
        }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
        tween(glow, 0.25, { BackgroundTransparency = state and 0 or 1 })
        tween(trackStroke, 0.25, { Color = state and Colors.Accent or Colors.Stroke })
        highlight(state)
        setConfig(cfgKey, state)
        if not silent and callback then task.spawn(callback, state) end
    end

    connect(row.MouseButton1Click, function() apply(not state) end)
    register(cfgKey, function(v) if type(v) == "boolean" and v ~= state then apply(v) end end, function() return state end, default or false)

    if default then apply(true, true) end
    return {
        Set = function(v, silent) if v ~= state then apply(v, silent) end end,
        Get = function() return state end,
    }
end

function Section:CreateSlider(name, min, max, default, callback, fmt)
    fmt = fmt or tostring
    local cfgKey = self.tab.label.Text .. "/" .. self.name .. "/" .. name
    local row, titleLbl = self:_row(name, nil, 44)
    titleLbl.Position = UDim2.fromOffset(12, 7)

    local valueW = 40
    for _, v in ipairs({ min, max, default }) do
        valueW = math.max(valueW, TextService:GetTextSize(fmt(v), 10, Enum.Font.GothamBold, Vector2.new(200, 20)).X + 16)
    end
    titleLbl.Size = UDim2.new(1, -(valueW + 30), 0, 16)

    local valueLabel = create("TextLabel", {
        Text = fmt(default),
        Font = Enum.Font.GothamBold,
        TextSize = 10,
        TextColor3 = Colors.Text,
        BackgroundColor3 = Colors.Background,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -10, 0, 6),
        Size = UDim2.fromOffset(valueW, 18),
        Parent = row,
    })
    addCorner(valueLabel, 6)
    addStroke(valueLabel)

    local bar = create("Frame", {
        Position = UDim2.new(0, 12, 0, 31),
        Size = UDim2.new(1, -24, 0, 5),
        BackgroundColor3 = Colors.Background,
        BorderSizePixel = 0,
        Parent = row,
    })
    makeRound(bar)
    addStroke(bar)

    local pct = (default - min) / (max - min)
    local fillBar = create("Frame", {
        Size = UDim2.new(pct, 6 - 12 * pct, 1, 0),
        BackgroundColor3 = Colors.Accent,
        BorderSizePixel = 0,
        Parent = bar,
    })
    makeRound(fillBar)

    local track = create("Frame", {
        Position = UDim2.fromOffset(6, 0),
        Size = UDim2.new(1, -12, 1, 0),
        BackgroundTransparency = 1,
        ZIndex = 2,
        Parent = bar,
    })
    local knob = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(pct, 0.5),
        Size = UDim2.fromOffset(12, 12),
        BackgroundColor3 = Colors.Accent,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = track,
    })
    makeRound(knob)
    create("UIStroke", { Color = Colors.Element, Thickness = 2, Parent = knob })

    local hit = create("TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 22),
        Size = UDim2.new(1, 0, 0, 22),
        ZIndex = 3,
        Parent = row,
    })

    local last = default
    local dragging = false

    local function render(val, t)
        local r = (val - min) / (max - min)
        tween(knob, t or 0.08, { Position = UDim2.fromScale(r, 0.5) }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
        tween(fillBar, t or 0.08, { Size = UDim2.new(r, 6 - 12 * r, 1, 0) }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
        valueLabel.Text = fmt(val)
    end

    local function set(x)
        local w = math.max(track.AbsoluteSize.X, 1)
        local rel = math.clamp((x - track.AbsolutePosition.X) / w, 0, 1)
        local val = math.floor(min + (max - min) * rel + 0.5)
        render(val, 0.08)
        if val ~= last then
            last = val
            setConfig(cfgKey, val)
            if callback then task.spawn(callback, val) end
        end
    end

    connect(hit.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            set(input.Position.X)
        end
    end)
    connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            set(input.Position.X)
        end
    end)
    connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    register(cfgKey, function(v) if type(v) == "number" then render(v, 0.3) last = v end end, function() return last end, default)

    return {
        Set = function(v, silent)
            v = math.clamp(v, min, max)
            render(v, 0.3)
            last = v
            setConfig(cfgKey, v)
            if not silent and callback then task.spawn(callback, v) end
        end,
        Get = function() return last end,
    }
end

